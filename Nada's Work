-- ==========================
-- IoT Sensor Project Schema
-- ==========================

-- 1) Sensors master data
CREATE TABLE IF NOT EXISTS sensors (
    device_id          VARCHAR(50) PRIMARY KEY,
    device_name        VARCHAR(100),
    device_type        VARCHAR(50),      
    location           VARCHAR(100),    
    installed_at       TIMESTAMPTZ,
    is_active          BOOLEAN DEFAULT TRUE,
    last_seen_at       TIMESTAMPTZ
);

-- 2) Readings time-series
CREATE TABLE IF NOT EXISTS readings (
    reading_id         BIGSERIAL PRIMARY KEY,
    device_id          VARCHAR(50) NOT NULL,
    ts                 TIMESTAMPTZ NOT NULL,
    temperature_c      NUMERIC(5,2),
    humidity_pct       NUMERIC(5,2),
    battery_level_pct  NUMERIC(5,2),

    CONSTRAINT fk_readings_device
        FOREIGN KEY (device_id)
        REFERENCES sensors(device_id)
        ON DELETE CASCADE
);

-- Prevent duplicate readings for the same device & timestamp
CREATE UNIQUE INDEX IF NOT EXISTS ux_readings_device_ts
    ON readings(device_id, ts);

-- Main index for time-series queries by device & time
CREATE INDEX IF NOT EXISTS ix_readings_device_ts
    ON readings(device_id, ts DESC);

-- 3) Alerts table
CREATE TABLE IF NOT EXISTS alerts (
    alert_id           BIGSERIAL PRIMARY KEY,
    device_id          VARCHAR(50) NOT NULL,
    ts                 TIMESTAMPTZ NOT NULL,   
    rule_name          VARCHAR(100) NOT NULL,
    severity           VARCHAR(20) NOT NULL,   
    temperature_c      NUMERIC(5,2),
    humidity_pct       NUMERIC(5,2),
    message            TEXT,
    acknowledged       BOOLEAN DEFAULT FALSE,
    acknowledged_at    TIMESTAMPTZ,

    CONSTRAINT fk_alerts_device
        FOREIGN KEY (device_id)
        REFERENCES sensors(device_id)
        ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS ix_alerts_device_ts
    ON alerts(device_id, ts DESC);
